# Postgres for @digitalcrew/auth
DIGITALCREW_AUTH_DATABASE_URL=postgresql://user:password@localhost:5432/digitalcrew_auth

# Secret for the auth service
DIGITALCREW_AUTH_SECRET=

# Public URL of the app that mounts the auth handler (orchestrator or self-hosted agent)
DIGITALCREW_AUTH_URL=http://localhost:3000

# Comma-separated origins allowed for CORS / CSRF (e.g. http://localhost:3000,http://localhost:3001)
DIGITALCREW_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Optional: Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# production (default) | preprod | staging. Outside production, loadAuthEnv() refuses
# any DIGITALCREW_AUTH_* value that names a production host (*.digitalcrew.tech).
APP_ENV=production

# Production: root cookie domain for *.yourdomain.com SSO (leading dot), e.g. .yourdomain.com
DIGITALCREW_AUTH_COOKIE_DOMAIN=

# Multi-tenant (organizations = tenants). Optional limits:
# AUTH_MAX_ORGANIZATIONS_PER_USER=10
# AUTH_MAX_MEMBERS_PER_ORGAN=100
# AUTH_ALLOW_USER_CREATE_ORGAN=true
